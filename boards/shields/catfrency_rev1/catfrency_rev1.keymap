                &kp A   &kp A   &kp S   &kp D   &kp F   &kp G                       &kp H   &kp J   &kp K   &kp L   &kp A   &kp A   &kp A   &kp A   
                &kp A           &kp Z   &kp X   &kp C   &kp V   &kp B               &kp N   &kp M   &kp A   &kp A   &kp A   &kp A   &kp A   &kp A    
                &kp A   &kp A   &kp A           &kp A           &kp A               &kp A   &kp A   &kp A   &kp A   &kp A   &kp A   &kp A   &kp A    
                                                                                                                                    &kp A   &kp A   
            >;
        };
        
        abc {

            bindings = <
                &kp A   &kp A   &kp A   &kp A   &kp A   &kp A   &kp A   &kp A       &kp A   &kp A   &kp A   &kp A   &kp A   &kp A   &kp A   &kp A     
